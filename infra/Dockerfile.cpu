FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential git wget libxrender1 libxext6 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY . .

RUN pip install --no-cache-dir -e ".[aws,ml]"

ENTRYPOINT ["python", "-m", "deepchem_server.aws.command"]
